%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ccaee0d8bca9d245920f4b1cb33a359, type: 3}
  m_Name: TutorialData
  m_EditorClassIdentifier: Assembly-CSharp::TutorialData
  OutGame:
  - Type: 0
    Title: "\uC81C\uB2E8"
    Body: "\uC81C\uB2E8\uC740 \uAC8C\uC784\uC758 \uBC29\uC2DD\uC744 \uBC14\uAFC0
      \uC218 \uC788\uB294 \uAC15\uB825\uD55C \uD6A8\uACFC\uB97C \uAC00\uC9C0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \uD50C\uB808\uC774\uD558\uACE0 \uC2F6\uC740 \uC2A4\uD0C0\uC77C\uC5D0
      \uB9DE\uCDB0 \uC81C\uB2E8\uC744 \uC120\uD0DD\uD574 \uBCF4\uC138\uC694!\n\n\uC7A0\uAE34
      \uC81C\uB2E8\uC758 \uD6A8\uACFC\uB3C4 \uC0B4\uD3B4\uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    NextLabel: "\uB2E4\uC74C"
  - Type: 1
    Title: "\uD2B9\uC131"
    Body: "\uC6D0\uC815\uC5D0\uC11C \uC5BB\uC740 \uC601\uAD6C \uC7AC\uD654\uB85C
      \uD2B9\uC131\uC744 \uC131\uC7A5\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uAC15\uD654\uD55C \uD2B9\uC131\uC740 \uB2E4\uC74C \uC6D0\uC815\uC5D0\uB3C4
      \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\n\uC9C0\uAE08\uC740 \uC7AC\uD654\uAC00 \uC5C6\uC5B4\uB3C4
      \uAD1C\uCC2E\uC544\uC694. \uD6A8\uACFC\uBD80\uD130 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 2
    Title: "\uD1A0\uD15C"
    Body: "\uD1A0\uD15C\uC740 \uC6D0\uC815\uC758 \uB09C\uB3C4\uB97C \uB192\uC774\uB294
      \uB300\uC2E0 \uC815\uC0B0 \uBCF4\uB108\uC2A4\uB97C \uB354\uD574 \uC90D\uB2C8\uB2E4.\n\n\uCCAB
      \uC6D0\uC815\uC5D0\uB294 \uC801\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uD6A8\uACFC\uB294 \uC790\uC720\uB86D\uAC8C \uD655\uC778\uD560 \uC218 \uC788\uACE0
      \uCCAB \uC6D0\uC815\uC744 \uB9C8\uCE58\uBA74 \uD65C\uC131\uD654 \uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    NextLabel: "\uB2E4\uC74C"
  - Type: 3
    Title: "\uC900\uBE44\uAC00 \uB418\uBA74 \uC9C1\uC811 \uCD9C\uBC1C\uD558\uC138\uC694"
    Body: "\uC124\uBA85\uC774 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uC81C\uB2E8\xB7\uD2B9\uC131\xB7\uD1A0\uD15C\uC744
      \uC790\uC720\uB86D\uAC8C \uB458\uB7EC\uBCF4\uC138\uC694.\n\n\uD1A0\uD15C \uD654\uBA74\uC758
      \uC2DC\uC791 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uCCAB \uC6D0\uC815\uC774
      \uC2DC\uC791\uB429\uB2C8\uB2E4."
    NextLabel: "\uC790\uC720\uB86D\uAC8C \uB458\uB7EC\uBCF4\uAE30"
  InGame:
  - Type: 4
    Title: "\uCF54\uC5B4 \uAC74\uBB3C"
    Body: "\uCF54\uC5B4\uB294 \uAE30\uC9C0 \uC131\uC7A5\uC758 \uC911\uC2EC\uC785\uB2C8\uB2E4.
      \uCF54\uC5B4\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uBA74 \uAC74\uC124
      \uD55C\uB3C4\uAC00 \uB298\uACE0 \uC0C8\uB85C\uC6B4 \uAC74\uBB3C\uACFC \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00
      \uC5F4\uB9BD\uB2C8\uB2E4.\n\n\uC774\uC5B4\uC11C \uC2E4\uC81C \uAC74\uC124 \uD654\uBA74\uC744
      \uC0B4\uD3B4\uBCFC\uAC8C\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 5
    Title: "\uBE48 \uAC74\uC124 \uC2AC\uB86F\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694"
    Body: "\uAC74\uC124 \uBC84\uD2BC \uB300\uC2E0 \uAE30\uC9C0\uC758 \uBE48 \uC2AC\uB86F\uC744
      \uD074\uB9AD\uD574 \uAC74\uC124 \uBAA9\uB85D\uC744 \uC5FD\uB2C8\uB2E4.\n\n\uBC1D\uAC8C
      \uD45C\uC2DC\uB41C \uC2AC\uB86F\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 6
    Title: "\uC774 \uD654\uBA74\uC5D0\uC11C \uAC74\uC124\uD560 \uC218 \uC788\uC5B4\uC694"
    Body: "\uBE48 \uC2AC\uB86F\uC744 \uB204\uB974\uBA74 \uC774 \uAC74\uC124 \uD654\uBA74\uC774
      \uC5F4\uB9BD\uB2C8\uB2E4. \uCE74\uB4DC\uC758 \uBE44\uC6A9\uC744 \uD655\uC778\uD558\uACE0
      \uC6D0\uD558\uB294 \uAC74\uBB3C\uC744 \uC120\uD0DD\uD558\uBA74 \uD574\uB2F9
      \uC2AC\uB86F\uC5D0 \uAC74\uC124\uB429\uB2C8\uB2E4.\n\n\uC804\uD22C \uAC74\uBB3C\uC740
      \uC544\uAD70\uC744 \uC0DD\uC0B0\uD558\uACE0, \uC790\uC6D0 \uAC74\uBB3C\uC740
      \uACE8\uB4DC\uB97C \uC0DD\uC0B0\uD558\uBA70, \uC5F0\uAD6C \uAC74\uBB3C\uC740
      \uC544\uAD70\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4."
    NextLabel: "\uB2E4\uC74C"
  - Type: 7
    Title: "\uAC74\uBB3C \uC0C1\uC138\uC815\uBCF4 \uD655\uC778"
    Body: "\uC804\uD22C \uAC74\uBB3C\uC740 \uC804\uC0AC\xB7\uAC80\uC0AC\xB7\uAD81\uC218\xB7\uB9C8\uBC95\uC0AC\xB7\uAD11\uC2E0\uB3C4
      \uACC4\uC5F4\uB85C \uB098\uB269\uB2C8\uB2E4. \uCE74\uB4DC\uC758 [i]\uC5D0\uC11C
      \uD2B9\uC9D5\uACFC \uC131\uC7A5 \uACBD\uB85C\uB97C \uD655\uC778\uD558\uC138\uC694.\n\n\uAC74\uC124
      \uD6C4\uC5D0\uB294 \uAC19\uC740 \uC2AC\uB86F\uC744 \uB20C\uB7EC \uAD00\uB9AC
      \uD654\uBA74\uC744 \uC5F4\uACE0 \uBD84\uAE30\uB97C \uC120\uD0DD\uD574 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBE44\uC6A9\uACFC \uCF54\uC5B4 \uB808\uBCA8
      \uC870\uAC74\uB3C4 \uD655\uC778\uD558\uC138\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 8
    Title: "\uCF54\uC5B4 \uC5C5\uADF8\uB808\uC774\uB4DC \uBC84\uD2BC"
    Body: "\uCF54\uC5B4 \uC2AC\uB86F\uC744 \uB204\uB974\uBA74 \uC774 \uAD00\uB9AC
      \uD654\uBA74\uC774 \uC5F4\uB9BD\uB2C8\uB2E4. \uC5C5\uADF8\uB808\uC774\uB4DC
      \uBC84\uD2BC\uC5D0\uC11C \uBE44\uC6A9\uC744 \uD655\uC778\uD558\uACE0 \uCF54\uC5B4\uB97C
      \uC131\uC7A5\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uCF54\uC5B4\uAC00
      \uC131\uC7A5\uD558\uBA74 \uAC74\uC124 \uD55C\uB3C4\uC640 \uAC74\uBB3C\uC758
      \uC131\uC7A5 \uC120\uD0DD\uC9C0\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4. \uC548\uB0B4\uAC00
      \uB05D\uB09C \uB4A4 \uC9C1\uC811 \uC0AC\uC6A9\uD574 \uBCF4\uC138\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 9
    Title: "\uC544\uD2F0\uD329\uD2B8 \uC778\uBCA4\uD1A0\uB9AC"
    Body: "\uBCF4\uC720 \uC720\uBB3C \uBC84\uD2BC\uC5D0\uC11C \uC774\uBC88 \uC6D0\uC815\uC5D0
      \uD68D\uB4DD\uD55C \uC544\uD2F0\uD329\uD2B8\uC640 \uC801\uC6A9 \uD6A8\uACFC\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCC98\uC74C\uC5D0\uB294
      \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    NextLabel: "\uB2E4\uC74C"
  - Type: 10
    Title: "\uB3C4\uAC10"
    Body: "\uB3C4\uAC10\uC5D0\uC11C \uC720\uB2DB\uACFC \uAC74\uBB3C, \uC544\uD2F0\uD329\uD2B8
      \uC815\uBCF4\uB97C \uC0B4\uD3B4\uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAD81\uAE08\uD55C
      \uD6A8\uACFC\uB098 \uC131\uC7A5 \uBC29\uD5A5\uC744 \uD655\uC778\uD574 \uBCF4\uC138\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 11
    Title: "\uBC30\uC18D \uBC84\uD2BC"
    Body: "\uBC30\uC18D \uBC84\uD2BC\uC73C\uB85C \uC9C4\uD589 \uC18D\uB3C4\uB97C
      \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC804\uD22C\uB97C \uC775\uD790
      \uB54C\uB294 \uAE30\uBCF8 \uC18D\uB3C4\uB85C, \uC775\uC219\uD574\uC9C0\uBA74
      \uBE60\uB974\uAC8C \uC9C4\uD589\uD574 \uBCF4\uC138\uC694."
    NextLabel: "\uB2E4\uC74C"
  - Type: 12
    Title: "\uC18C\uBAA8\uC544\uC774\uD15C"
    Body: "\uD68D\uB4DD\uD55C \uC18C\uBAA8\uC544\uC774\uD15C\uC740 \uC774 \uC2AC\uB86F\uC5D0\uC11C
      \uD655\uC778\uD558\uACE0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC0AC\uC6A9\uD558\uBA74 \uC218\uB7C9\uC774 \uC904\uC5B4\uB4DC\uB2C8 \uD544\uC694\uD55C
      \uC21C\uAC04\uC744 \uACE8\uB77C\uBCF4\uC138\uC694.\n\n\uC124\uBA85 \uC911\uC5D0\uB294
      \uC544\uC774\uD15C\uC744 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    NextLabel: "\uB2E4\uC74C"
  - Type: 13
    Title: "\uCCAB \uBC29\uC5B4\uB97C \uC900\uBE44\uD574 \uBCF4\uC138\uC694"
    Body: "\uC774\uC81C \uC9C1\uC811 \uAC74\uBB3C\uC744 \uC9D3\uACE0 \uC804\uD22C\uB97C
      \uC900\uBE44\uD558\uC138\uC694. \uD544\uC694\uD558\uBA74 \uC778\uBCA4\uD1A0\uB9AC\uC640
      \uB3C4\uAC10\uC5D0\uC11C \uC815\uBCF4\uB97C \uB2E4\uC2DC \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    NextLabel: "\uD50C\uB808\uC774 \uC2DC\uC791"
